{
  "version": "1.0.10",
  "app_name": "KZBS PhoneLink",
  "discovery": {
    "transport": "UDP broadcast",
    "ping": "KZBS_DISCOVERY_PING",
    "port": 4956
  },
  "connection": {
    "transport": "WebSocket",
    "port": 4955,
    "phone_path": "/phone?code=<first-pairing-code>|token=<saved-device-token>",
    "pairing": "first connection uses a time-limited code or QR, then the phone stores a persistent device token",
    "desktop_path": "/client"
  },
  "commands": [
    "SEND_SMS",
    "REQ_SYNC_ALL"
  ],
  "phone_events": [
    "DEVICE_HELLO",
    "SMS_RECEIVED",
    "SMS_SYNC_STATUS",
    "SMS_SEND_RESULT",
    "SMS_SYNCED",
    "CONTACTS_SYNCED",
    "CONTACTS_SYNC_STATUS"
  ],
  "desktop_events": [
    "INIT_STATE",
    "PAIRING_COMPLETE",
    "PHONE_CONNECTION_CHANGED",
    "DEVICE_STATUS_UPDATED",
    "NEW_SMS",
    "MESSAGES_UPDATED",
    "MESSAGES_SYNC_STATUS",
    "CONTACTS_UPDATED",
    "CONTACTS_SYNC_STATUS",
    "APP_ERROR"
  ]
}
