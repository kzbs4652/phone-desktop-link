{
  "version": "1.0.5",
  "app_name": "KZBS PhoneLink",
  "discovery": {
    "transport": "UDP broadcast",
    "ping": "KZBS_DISCOVERY_PING",
    "port": 4956
  },
  "connection": {
    "transport": "WebSocket",
    "port": 4955,
    "phone_path": "/phone?code=<first-pairing-code>|token=<saved-device-token>",
    "pairing": "first connection uses a time-limited code or QR, then the phone stores a persistent device token",
    "desktop_path": "/client"
  },
  "commands": [
    "DIAL_CALL",
    "ADD_CALL",
    "END_CALL",
    "DTMF_TONE",
    "CALL_MUTE",
    "CALL_ROUTE",
    "CALL_HOLD",
    "CALL_UNHOLD",
    "SEND_SMS",
    "REQ_SYNC_ALL"
  ],
  "phone_events": [
    "DEVICE_HELLO",
    "PHONE_ACTION_RESULT",
    "SMS_RECEIVED",
    "SMS_SEND_RESULT",
    "SMS_SYNCED",
    "CALL_STATE_CHANGED",
    "CONTACTS_SYNCED",
    "CALL_LOGS_SYNCED"
  ],
  "desktop_events": [
    "INIT_STATE",
    "PAIRING_COMPLETE",
    "PHONE_CONNECTION_CHANGED",
    "DEVICE_STATUS_UPDATED",
    "ACTIVE_CALL_CHANGED",
    "CALL_DURATION_TICK",
    "NEW_SMS",
    "MESSAGES_UPDATED",
    "CONTACTS_UPDATED",
    "CALL_LOGS_UPDATED",
    "APP_ERROR"
  ]
}
