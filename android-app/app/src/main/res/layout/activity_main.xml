<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B14"
    android:padding="24dp">

    <!-- Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KZBS PhoneLink"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" v1.0.0"
            android:textColor="#00F2FE"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Connection Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#162138"
        android:padding="18dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Arka Plan Servisi Aktif"
            android:textColor="#30D158"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bilgisayarınız açık olduğunda sıfır dokunuşla otomatik eşleşir."
            android:textColor="#8E8E93"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Update Status Banner (Hidden if up-to-date) -->
    <LinearLayout
        android:id="@+id/layoutUpdateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1430"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvUpdateBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚀 Yeni güncelleme mevcut!"
            android:textColor="#00F2FE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDownloadUpdate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="İndir"
            android:textSize="12sp"
            android:backgroundTint="#00F2FE"
            android:textColor="#070B14" />
    </LinearLayout>

    <!-- Control Buttons -->
    <Button
        android:id="@+id/btnPermissions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🛡️ İzinleri Kontrol Et / Ver"
        android:backgroundTint="#00F2FE"
        android:textColor="#070B14"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnCheckUpdates"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🔄 Yazılım Güncellemelerini Denetle"
        android:backgroundTint="#162138"
        android:textColor="#00F2FE"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🛑 Köprüyü Duraklat / Kapat"
        android:backgroundTint="#2C1217"
        android:textColor="#FF453A"
        android:layout_marginBottom="16dp" />

    <!-- Live Event Log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Canlı Hareket Günlüğü:"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0C1322"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistem hazır. Olaylar bekleniyor..."
            android:textColor="#4FACFE"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
