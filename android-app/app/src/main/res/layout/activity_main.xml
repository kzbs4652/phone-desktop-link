<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B14"
    android:padding="24dp">

    <!-- Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KZBS PhoneLink"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" v1.0.0"
            android:textColor="#00F2FE"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Connection Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#162138"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Arka Plan Servisi Aktif"
            android:textColor="#30D158"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bilgisayarınız açık olduğunda sıfır dokunuşla otomatik eşleşir."
            android:textColor="#8E8E93"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Control Buttons -->
    <Button
        android:id="@+id/btnPermissions"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="🛡️ İzinleri Kontrol Et / Ver"
        android:backgroundTint="#00F2FE"
        android:textColor="#070B14"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBatteryOptimization"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="⚡ Pil Kısıtlamasını Kaldır (Kesintisiz Çalışma)"
        android:backgroundTint="#162138"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="🛑 Köprüyü Duraklat / Kapat"
        android:backgroundTint="#2C1217"
        android:textColor="#FF453A"
        android:layout_marginBottom="20dp" />

    <!-- Live Event Log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Canlı Hareket Günlüğü:"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0C1322"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistem hazır. Olaylar bekleniyor..."
            android:textColor="#4FACFE"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
